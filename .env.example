# ===== AquaBlast - variáveis de ambiente =====
# Copie para .env e preencha. Nunca commite o .env.

NODE_ENV=development
# URL pública do site (usada nos links dos e-mails e no SEO)
APP_URL=http://localhost:3000

# Postgres. Em Docker/Portainer use: postgres://aquablast:<POSTGRES_PASSWORD>@db:5432/aquablast
DATABASE_URL=postgres://aquablast:aquablast@127.0.0.1:5432/aquablast

# Segredos da aplicação (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
# 32 bytes em base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
APP_ENCRYPTION_KEY=
# Compõe a URL do webhook do checkout: https://SEU-DOMINIO/api/webhooks/checkout/<CHECKOUT_WEBHOOK_TOKEN>
CHECKOUT_WEBHOOK_TOKEN=
# Header "Authorization: Bearer <CRON_SECRET>" nos endpoints /api/cron/*
CRON_SECRET=

# Admin inicial (criado só se não existir nenhum admin)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-forte

# E-mail (semente inicial; depois é editado no painel e fica cifrado no banco)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AquaBlast
EMAIL_FROM_ADDRESS=

# 17TRACK (opcional aqui; pode ser colada no painel)
TRACKING_17TRACK_API_KEY=

# Só para o docker-compose
POSTGRES_PASSWORD=
# Intervalo (segundos) em que o serviço `scheduler` chama /api/cron/* (padrão 900 = 15 min)
SCHEDULER_INTERVAL_SECONDS=900
# Token do túnel (Cloudflare Zero Trust → Tunnels). Obrigatório na stack de produção;
# no teste local com docker-compose.local.yml qualquer texto serve.
CLOUDFLARE_TUNNEL_TOKEN=
